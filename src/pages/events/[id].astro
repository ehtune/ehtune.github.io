---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { institutionById } from '../../lib/data';
import { url, dateRange, today } from '../../lib/utils';

export async function getStaticPaths() {
  return (await getCollection('events')).map((e) => ({ params: { id: e.id }, props: { event: e } }));
}
const { event } = Astro.props;
const d = event.data;
const { Content } = await render(event);
const inst = institutionById(d.institution, `Event "${event.id}"`);
const isPast = (d.endDate ?? d.date) < today();
---
<BaseLayout title={d.title} description={d.summary}>
  <PageHeader
    title={d.title}
    intro={d.summary}
    crumbs={[{ label: 'News & Events', href: '/events/' }, ...(isPast ? [{ label: 'Past events', href: '/events/past/' }] : [])]}
  />
  {d.photo && (
    <figure id="photo" class="container-page scroll-mt-28 pt-14">
      <img src={url(d.photo)} alt={d.photoCaption ?? `Photo of ${d.title}`} class="w-full max-w-5xl border border-pietra-200" decoding="async" />
      {d.photoCaption && <figcaption class="mt-2 text-[0.9rem] text-pietra">{d.photoCaption}</figcaption>}
    </figure>
  )}
  <div class="container-page grid gap-12 pt-14 lg:grid-cols-12">
    <aside class="lg:order-2 lg:col-span-4">
      <dl class="space-y-4 border-t-[3px] border-double border-cinabro pt-5 text-[0.98rem]">
        <div><dt class="text-pietra">Date</dt><dd class="font-display text-[1.4rem]">{dateRange(d.date, d.endDate)}</dd></div>
        {d.time && <div><dt class="text-pietra">Time</dt><dd>{d.time}</dd></div>}
        <div><dt class="text-pietra">Place</dt><dd>{d.location}{inst && <span class="block text-pietra">{inst.name}</span>}</dd></div>
        <div><dt class="text-pietra">Type</dt><dd>{d.type}</dd></div>
        {d.speakers.length > 0 && <div><dt class="text-pietra">Speakers</dt><dd>{d.speakers.map((s) => <span class="block">{s}</span>)}</dd></div>}
      </dl>
      <div class="mt-8 flex flex-wrap gap-3">
        {d.registration && !isPast && <a href={d.registration} class="btn btn-primary">Register</a>}
        {d.programme && <a href={url(d.programme)} class={isPast ? 'btn btn-primary' : 'btn btn-secondary'}>{d.cancelled ? 'Planned programme (PDF)' : 'Programme (PDF)'}</a>}
      </div>
      {d.videos.length > 0 && (
        <section id="videos" class="mt-10 scroll-mt-28" aria-labelledby="videos-title">
          <h2 id="videos-title" class="text-[1.3rem]">{d.videos.length === 1 ? 'Video recording' : 'Video recordings'}</h2>
          <ul class="mt-3 divide-y divide-pietra-200 border-y border-pietra-200">
            {d.videos.map((v) => (
              <li>
                <a href={v.url} class="group/v flex items-center gap-3 py-3 text-ink hover:text-blu">
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-cinabro text-white group-hover/v:bg-blu" aria-hidden="true">
                    <svg class="ml-0.5 size-3.5" viewBox="0 0 12 12"><path d="M2.5 1.2v9.6L10.5 6z" fill="currentColor"/></svg>
                  </span>
                  <span class="font-semibold">{v.label}</span>
                  <span class="ml-auto text-[0.85rem] text-pietra">{v.url.includes('youtu') ? 'YouTube' : 'Video'}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
    <article class="prose-ehtune lg:order-1 lg:col-span-8">
      {d.cancelled && <p class="not-prose mb-6 border-l-[3px] border-double border-cinabro bg-cinabro-50 px-5 py-3 font-semibold text-cinabro">This event was cancelled{d.cancelledReason ? ` ${d.cancelledReason}` : ''}. The programme below is the one that had been planned.</p>}
      <Content />
    </article>
  </div>
</BaseLayout>
