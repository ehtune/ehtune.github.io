---
// The members list moved to /members/ (October 2026). This page forwards old links there.
import { url } from '../../lib/utils';
const to = url('/members/');
const inst = url('/about/institutions/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Members moved</title>
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ inst }}>if (location.hash === '#institutions') location.replace(inst);</script>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
  </head>
  <body><p>The members list has moved: <a href={to}>{to}</a></p></body>
</html>
