---
// ABOUT — Mission and history. The other About pages (What we do, Partner institutions,
// Supporters) each have their own page and menu entry. Texts live in src/data/site.yml.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../lib/data';
import { url } from '../../lib/utils';
const historyParas = site.history.trim().split(/\n\s*\n/);
const next = [
  { href: '/about/what-we-do/', title: 'What we do', text: 'Seminars, workshops, doctoral training and joint research.', accent: 'var(--color-cinabro)' },
  { href: '/members/', title: 'Members', text: 'The economic historians who make up the network.', accent: 'var(--color-blu)' },
  { href: '/about/institutions/', title: 'Partner institutions', text: 'The universities and schools behind the network.', accent: 'var(--color-dot-6)' },
  ...(site.supporters.length ? [{ href: '/about/supporters/', title: 'Supporters', text: 'The institutions that support our activities.', accent: 'var(--color-corallo)' }] : []),
];
---
<BaseLayout title="Mission and history" description={site.mission}>
  <PageHeader title="Mission and history" intro={site.tagline} crumbs={[{ label: 'About', href: '/about/' }]} />

  <div class="container-page">
    <section class="grid gap-10 py-16 lg:grid-cols-12" aria-labelledby="mission">
      <h2 id="mission" class="dots-rule pb-4 text-[2.2rem] lg:col-span-4 lg:self-start">Mission</h2>
      <p class="text-[1.2rem] leading-relaxed lg:col-span-7">{site.mission}</p>
    </section>

    <section class="grid gap-10 border-t border-pietra-200 py-16 lg:grid-cols-12" aria-labelledby="history">
      <h2 id="history" class="dots-rule pb-4 text-[2.2rem] lg:col-span-4 lg:self-start">Our history</h2>
      <div class="space-y-5 text-[1.08rem] leading-[1.75] lg:col-span-7">{historyParas.map((p) => <p>{p}</p>)}</div>
    </section>
  </div>

  <section class="border-t border-blu-100 bg-blu-50 py-16" aria-labelledby="more-title">
    <div class="container-page">
      <h2 id="more-title" class="mb-8 text-[1.6rem]">More about the network</h2>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {next.map((n) => (
          <li class="relative border border-pietra-200 bg-carta p-6 transition-shadow hover:shadow-[0_14px_30px_-18px_rgb(14_36_65/0.45)]" style={`border-top:5px solid ${n.accent}`}>
            <h3 class="text-[1.3rem]"><a href={url(n.href)} class="after:absolute after:inset-0 hover:underline">{n.title}</a></h3>
            <p class="mt-2 text-[0.97rem] text-ink/80">{n.text}</p>
            <span class="mt-4 inline-block font-semibold text-cinabro" aria-hidden="true">→</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
