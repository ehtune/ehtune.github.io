---
// Homepage opening: the network's name and mission beside the map of its institutions.
import TuscanyMap from './TuscanyMap.astro';
import { site, institutions } from '../lib/data';
import { url } from '../lib/utils';
interface Props { hasUpcoming?: boolean }
const { hasUpcoming = true } = Astro.props;
const cities = new Set(institutions.map((i) => i.city)).size;
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const n = (x: number) => words[x] ?? String(x);
---
<section class="relative overflow-hidden border-b border-pietra-200 bg-carta" aria-labelledby="hero-title">
  <div class="container-page grid items-center gap-10 py-12 md:py-16 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16 lg:py-20">
    <div>
      <p class="mb-5 flex items-center gap-3 text-[1.05rem] font-bold tracking-wide text-blu">
        <span class="dot-strip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        {site.shortName}
      </p>
      <h1 id="hero-title" class="text-display !text-cinabro">{site.fullName}</h1>
      <p class="mt-7 max-w-[54ch] text-lg leading-relaxed text-ink/85 md:text-[1.2rem]">{site.mission}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={url('/about/')} class="btn btn-primary">About the network</a>
        {hasUpcoming
          ? <a href={url('/events/')} class="btn btn-secondary">Upcoming events</a>
          : <a href={url('/events/past/')} class="btn btn-secondary">Past workshops</a>}
      </div>
      <p class="mt-10 max-w-[48ch] border-l-4 border-cinabro bg-blu-50 py-3 pl-4 pr-3 text-[0.98rem] text-ink/80">
        {n(institutions.length).replace(/^./, (c) => c.toUpperCase())} partner institutions in {n(cities)} Tuscan cities.
        <a href={url('/members/')} class="link ml-1 whitespace-nowrap">Meet the members</a>
      </p>
    </div>
    <div class="mx-auto w-full max-w-[34rem] lg:max-w-none">
      <TuscanyMap />
    </div>
  </div>
</section>

<style>
  /* The logo's six dots laid out in a row. */
  .dot-strip { display: inline-flex; gap: 5px; padding: 5px 7px; background: var(--color-bar); transform: skewX(-12deg); }
  .dot-strip i { width: 9px; height: 9px; border-radius: 50%; transform: skewX(12deg); }
  .dot-strip i:nth-child(1) { background: var(--color-dot-1); }
  .dot-strip i:nth-child(2) { background: var(--color-dot-2); }
  .dot-strip i:nth-child(3) { background: var(--color-dot-3); }
  .dot-strip i:nth-child(4) { background: var(--color-dot-4); }
  .dot-strip i:nth-child(5) { background: var(--color-dot-5); }
  .dot-strip i:nth-child(6) { background: var(--color-dot-6); }
</style>
