---
// Members in alphabetical order of surname, grouped under index letters like a register.
// The list comes from src/data/members.yml. Filter by institution and search are added by
// the small script below; without JavaScript the full list is simply shown.
import { members, institutions } from '../lib/data';

const letterOf = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').charAt(0).toUpperCase();
const letters = [...new Set(members.map((m) => letterOf(m.surname)))];
const usedInstitutions = institutions.filter((i) => members.some((m) => m.institution === i.id));
---
<div data-directory>
  <div class="mb-10 flex flex-col gap-4 border-y border-pietra-200 bg-carta px-4 py-4 md:flex-row md:items-center md:justify-between" data-controls hidden>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by institution">
      <button type="button" data-filter="all" aria-pressed="true" class="filter-btn">All</button>
      {usedInstitutions.map((i) => <button type="button" data-filter={i.id} aria-pressed="false" class="filter-btn" title={i.name}>{i.shortName}</button>)}
    </div>
    <label class="flex items-center gap-2 text-[0.95rem]">
      <span class="text-pietra">Search</span>
      <input type="search" data-search-input placeholder="Name" class="w-full border border-pietra-200 bg-intonaco px-3 py-1.5 md:w-56" />
    </label>
  </div>

  {letters.length > 4 && (
    <nav aria-label="Jump to letter" class="mb-8 flex flex-wrap gap-1">
      {letters.map((l) => <a href={`#letter-${l}`} class="grid size-9 place-items-center font-display text-lg text-cipresso hover:bg-cipresso-100" data-letter-link={l}>{l}</a>)}
    </nav>
  )}

  <p class="mb-6 text-[0.95rem] text-pietra" aria-live="polite"><span data-count>{members.length}</span> members</p>

  {letters.map((l) => (
    <section id={`letter-${l}`} class="letter-group grid scroll-mt-28 gap-x-8 border-t border-pietra-200 py-6 sm:grid-cols-[4.5rem_1fr]" aria-label={l}>
      <h3 class="font-display text-[2.4rem] leading-none text-cinabro">{l}</h3>
      <ul class="mt-3 grid gap-x-10 gap-y-5 sm:mt-1 sm:grid-cols-2 lg:grid-cols-3">
        {members.filter((m) => letterOf(m.surname) === l).map((m) => (
          <li class="member" data-institution={m.institution} data-search={`${m.firstName} ${m.surname} ${m.inst.name} ${m.inst.shortName}`.toLowerCase()}>
            {m.url ? (
              <a href={m.url} class="group/name inline-flex items-baseline gap-1.5 font-display text-[1.3rem] leading-snug text-ink hover:text-cipresso">
                <span class="underline decoration-pietra-200 decoration-1 underline-offset-4 group-hover/name:decoration-cipresso">{m.firstName} <span class="font-semibold">{m.surname}</span></span>
                <svg class="size-3 shrink-0 text-pietra group-hover/name:text-cipresso" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2h6v6M10 2 3 9" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                <span class="sr-only">(personal page)</span>
              </a>
            ) : (
              <span class="font-display text-[1.3rem] leading-snug">{m.firstName} <span class="font-semibold">{m.surname}</span></span>
            )}
            <span class="mt-0.5 block text-[0.93rem] text-pietra">{m.inst.name}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p data-no-results hidden class="border-t border-pietra-200 py-10 text-pietra">No members match. Choose another institution or clear the search.</p>
</div>

<style>
  .filter-btn {
    padding: 0.3rem 0.8rem;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid var(--color-pietra-200);
    border-radius: 2px;
    color: var(--color-ink);
  }
  .filter-btn:hover { border-color: var(--color-cipresso); color: var(--color-cipresso); }
  .filter-btn[aria-pressed='true'] { background: var(--color-cipresso); border-color: var(--color-cipresso); color: var(--color-intonaco); }
  [data-letter-link][aria-disabled='true'] { color: var(--color-pietra-200); pointer-events: none; }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-directory]')) {
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const none = root.querySelector<HTMLElement>('[data-no-results]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    controls.hidden = false;
    let filter = 'all';
    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      for (const group of root.querySelectorAll<HTMLElement>('.letter-group')) {
        let inGroup = 0;
        for (const m of group.querySelectorAll<HTMLElement>('.member')) {
          const show = (filter === 'all' || m.dataset.institution === filter) && (!q || m.dataset.search!.includes(q));
          m.hidden = !show;
          if (show) inGroup++;
        }
        group.hidden = inGroup === 0;
        root.querySelector(`[data-letter-link="${group.getAttribute('aria-label')}"]`)?.setAttribute('aria-disabled', String(inGroup === 0));
        visible += inGroup;
      }
      count.textContent = String(visible);
      none.hidden = visible > 0;
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.filter!;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      }),
    );
    input.addEventListener('input', apply);
  }
</script>
