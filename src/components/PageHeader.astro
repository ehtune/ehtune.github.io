---
// Title band for inner pages: breadcrumb, title in ledger red, optional introduction,
// with the logo's dotted bar standing at the right edge.
import DotBar from './DotBar.astro';
import { url } from '../lib/utils';
interface Props {
  title: string;
  intro?: string;
  crumbs?: { label: string; href: string }[];
}
const { title, intro, crumbs = [] } = Astro.props;
---
<div class="relative overflow-hidden border-b border-blu-100 bg-blu-50">
  <DotBar class="pointer-events-none absolute right-[6%] top-1/2 hidden h-[135%] -translate-y-1/2 md:block" />
  <div class="container-page relative pb-12 pt-10 md:pb-16 md:pt-14">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-pietra">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={url('/')} class="hover:text-blu">Home</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="text-cinabro">/</span>
              <a href={url(c.href)} class="hover:text-blu">{c.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1 class="max-w-3xl text-[clamp(2.1rem,1.6rem+2.2vw,3.4rem)] leading-[1.06] !text-cinabro md:max-w-[75%]">{title}</h1>
    {intro && <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-ink/80">{intro}</p>}
    <slot />
  </div>
</div>
