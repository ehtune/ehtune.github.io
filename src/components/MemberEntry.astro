---
// One person in the members directory. Photo optional: without one, initials are shown.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { institutionById } from '../lib/data';
import { url, initials } from '../lib/utils';

interface Props { member: CollectionEntry<'members'>; featured?: boolean }
const { member, featured = false } = Astro.props;
const m = member.data;
const inst = institutionById(m.institution, `Member file "${member.id}.md"`)!;
const { Content } = await render(member);
const hasBio = Boolean(member.body?.trim());
---
<article
  class:list={['member border-t border-pietra-200 pt-5', featured && 'sm:flex sm:gap-8']}
  data-institution={inst.id}
  data-search={[m.name, m.role, inst.name, inst.city, ...m.interests].join(' ').toLowerCase()}
>
  <div class:list={['flex gap-4', featured ? 'sm:block sm:shrink-0' : '']}>
    {m.photo ? (
      <img
        src={url(m.photo)} alt={`Portrait of ${m.name}`} loading="lazy" decoding="async"
        class:list={['shrink-0 object-cover grayscale-[15%]', featured ? 'size-24 sm:size-44' : 'size-20']}
      />
    ) : (
      <div
        aria-hidden="true"
        class:list={['grid shrink-0 place-items-center bg-cipresso-100 font-display text-cipresso', featured ? 'size-24 text-4xl sm:size-44 sm:text-6xl' : 'size-20 text-[1.75rem]']}
      >{initials(m.name)}</div>
    )}
    <div class:list={[featured && 'sm:hidden']}>
      <h3 class="font-display text-[1.35rem] leading-tight">{m.name}</h3>
      <p class="mt-1 text-[0.93rem] leading-snug text-pietra">{m.role}</p>
    </div>
  </div>

  <div class:list={['mt-3', featured && 'sm:mt-0']}>
    {featured && (
      <div class="hidden sm:block">
        <h3 class="font-display text-[2rem] leading-tight">{m.name}</h3>
        <p class="mt-1 text-pietra">{m.role}</p>
      </div>
    )}
    <p class:list={['text-[0.95rem] font-semibold text-cipresso', featured && 'sm:mt-3']}>
      {inst.url ? <a href={inst.url} class="hover:underline">{inst.name}</a> : inst.name}
    </p>
    {m.department && <p class="text-[0.9rem] text-pietra">{m.department}</p>}
    {m.interests.length > 0 && (
      <p class="mt-2 text-[0.93rem] leading-snug"><span class="sr-only">Research interests: </span>{m.interests.join('; ')}</p>
    )}
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[0.9rem]">
      {m.email && <a class="link" href={`mailto:${m.email}`}>Email</a>}
      {m.website && <a class="link" href={m.website}>Website</a>}
    </p>
    {hasBio && (
      featured ? (
        <div class="prose-ehtune mt-4 text-[0.98rem]"><Content /></div>
      ) : (
        <details class="group/bio mt-3">
          <summary class="cursor-pointer list-none text-[0.9rem] font-semibold text-pietra hover:text-cipresso [&::-webkit-details-marker]:hidden">
            <span class="group-open/bio:hidden">Read biography</span><span class="hidden group-open/bio:inline">Hide biography</span>
          </summary>
          <div class="prose-ehtune mt-2 text-[0.95rem]"><Content /></div>
        </details>
      )
    )}
  </div>
</article>
