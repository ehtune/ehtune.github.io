---
import Logo from './Logo.astro';
import { site } from '../lib/data';
import { url } from '../lib/utils';
const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Rome' });
---
<footer class="mt-24 bg-cipresso-900 text-intonaco/85">
  <div class="container-page grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo inverse />
      <p class="mt-6 max-w-sm text-[0.95rem] leading-relaxed text-intonaco/70">{site.tagline}</p>
      <address class="mt-6 text-[0.95rem] not-italic leading-relaxed">
        {site.address.map((line) => <>{line}<br /></>)}
        <a href={`mailto:${site.email}`} class="mt-2 inline-block text-intonaco underline decoration-white/30 underline-offset-4 hover:decoration-white">{site.email}</a>
      </address>
    </div>

    <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
      {site.nav.filter((i) => i.children).map((item) => (
        <div>
          <h2 class="font-display text-lg text-intonaco">{item.label}</h2>
          <ul class="mt-3 space-y-1.5 text-[0.93rem]">
            {item.children!.map((c) => <li><a href={url(c.href)} class="hover:text-intonaco hover:underline">{c.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-[0.82rem] text-intonaco/60 md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.shortName}, {site.fullName}. Last updated {updated}.</p>
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        {site.social.map((s) => <a href={s.url} class="hover:text-intonaco">{s.label}</a>)}
        {site.repository && <a href={site.repository} class="hover:text-intonaco">Edit this site</a>}
        <span>Map boundaries: ISTAT, CC BY 4.0</span>
      </p>
    </div>
  </div>
</footer>
